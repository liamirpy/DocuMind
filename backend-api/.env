# ---------------------------------------------------
# PdfMind 
# ---------------------------------------------------
PROCESSOR_URL=http://agent-load-balancer:8080/v1/process-path
PROCESSOR_MOUNT_ROOT=/host/users
PROCESSOR_USE_LLM=true
PROCESSOR_OVERWRITE=false
PROCESSOR_TIMEOUT_MS=0









# ---------------------------------------------------
# Indexer 
# ---------------------------------------------------

INDEXING_URL=http://indexer-load-balancer:8080/v1/indexing/jobs
INDEXING_INPUT_MOUNT_ROOT=/data/input
INDEXING_OUTPUT_MOUNT_ROOT=/data/output


INDEXING_API_KEY=sk_live_T0xqJiQotn-U7_rIpXMKIpEe48L6XVJz5Ovhw8-WZJfYrxgI
INDEXING_TIMEOUT_MS=30000


# Check the indexing job every 3 seconds.
INDEXING_POLL_INTERVAL_MS=3000

# Wait for at most 30 minutes.
INDEXING_MAX_WAIT_MS=1800000

# Allow three temporary status-request failures.
INDEXING_MAX_STATUS_ERRORS=3

# Leave empty because your logs show that the indexer
# accepts the backend's absolute host paths.
INDEXING_MOUNT_ROOT=






# ---------------------------------------------------
# Ingester 
# ---------------------------------------------------


# OpenSearch ingestion service
INGEST_URL=http://ingester-load-balancer:8080/ingest
INGEST_TIMEOUT_MS=0

# false sends the data to OpenSearch.
# true only performs validation when supported by the API.
INGEST_DRY_RUN=false

EXPECTED_EMBEDDING_DIMENSIONS=1024

# Wait for chunks.json after indexing completes.
CHUNKS_FILE_WAIT_MS=30000
CHUNKS_FILE_POLL_INTERVAL_MS=1000


INGEST_API_KEY=sk_live_T0xqJiQotn-U7_rIpXMKIpEe48L6XVJz5Ovhw8-WZJfYrxgI












# ---------------------------------------------------
# Indexer for embedding question 
# ---------------------------------------------------



# Indexer embedding API
INDEXER_BASE_URL=http://indexer-load-balancer:8080

# This must have the same value as API_KEY in the indexer's .env.
INDEXER_API_KEY=sk_live_T0xqJiQotn-U7_rIpXMKIpEe48L6XVJz5Ovhw8-WZJfYrxgI

# OpenSearch
OPENSEARCH_NODE=https://opensearch:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=DOCUMIND_opensearch_password_2026

# Initially you can use the wildcard.
OPENSEARCH_INDEX=documind-chunks-*

# Your index template uses 1024 dimensions.
EMBEDDING_DIMENSIONS=1024

# Retrieval settings
RAG_CANDIDATE_K=30
RAG_TOP_K=8
RAG_MAX_CONTEXT_CHARS=18000

# Development only, when OpenSearch uses a self-signed certificate.
OPENSEARCH_TLS_REJECT_UNAUTHORIZED=false







# ---------------------------------------------------
# Ollama 
