### Opensearch 

# Existing backend configuration

# Indexer embedding API
INDEXER_BASE_URL=http://localhost:8000

# This must have the same value as API_KEY in the indexer's .env.
INDEXER_API_KEY=308cf79f43d7ef4213b0765afffd587f4aa58be50e7dada6844b776623ca8e49

# OpenSearch
OPENSEARCH_NODE=https://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=DOCUMIND_opensearch_password_2026

# Initially you can use the wildcard.
OPENSEARCH_INDEX=documind-chunks-*

# Your index template uses 1024 dimensions.
EMBEDDING_DIMENSIONS=1024

# Retrieval settings
RAG_CANDIDATE_K=30
RAG_TOP_K=8
RAG_MAX_CONTEXT_CHARS=18000

# Development only, when OpenSearch uses a self-signed certificate.
OPENSEARCH_TLS_REJECT_UNAUTHORIZED=false



##### OLLAMA configuration

# Local Ollama server
OLLAMA_BASE_URL=http://localhost:11434

# Recommended default
OLLAMA_MODEL=qwen2.5vl:7b

# Use this instead on a lower-resource machine:
# OLLAMA_MODEL=qwen2.5:3b

LLM_MAX_OUTPUT_TOKENS=1000
OLLAMA_KEEP_ALIVE=10m



