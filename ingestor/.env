# -----------------------------------------------------------------------------
# Input from the indexer
# -----------------------------------------------------------------------------
# Host directory mounted read-only at /input inside the container.
INDEXER_OUTPUT_HOST_DIR=/srv/DocuMind/pdf_example/indexer_output

# Choose ONE input style.
# Style A: directory containing chunks.json (recommended)
INPUT_DIR=/input/doc_456
INPUT_FILENAME=chunks.json

# Style B: exact file path. When set, INPUT_FILE takes precedence over INPUT_DIR.
INPUT_FILE=

# -----------------------------------------------------------------------------
# OpenSearch connection
# -----------------------------------------------------------------------------
# Use the Docker service name when both containers share the documind network.
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX=documind-chunks-v1

# Leave empty for your current development OpenSearch with security disabled.
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_CA_CERTS=

# Wait for OpenSearch if it is still starting.
OPENSEARCH_WAIT_TIMEOUT_SECONDS=120
OPENSEARCH_WAIT_INTERVAL_SECONDS=2
OPENSEARCH_REQUEST_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# Index template
# -----------------------------------------------------------------------------
# The image contains the mapping supplied with this project.
OPENSEARCH_INSTALL_TEMPLATE=true
OPENSEARCH_TEMPLATE_NAME=documind-chunks-template
OPENSEARCH_TEMPLATE_FILE=/app/templates/documind-chunks-template.json

# -----------------------------------------------------------------------------
# Ingestion behavior
# -----------------------------------------------------------------------------
OPENSEARCH_EMBEDDING_DIMENSIONS=1024
OPENSEARCH_BULK_BATCH_SIZE=250
INGESTOR_ALLOW_MISSING_EMBEDDINGS=false
INGESTOR_REPLACE_DOCUMENT=true
INGESTOR_REFRESH=true
INGESTOR_DRY_RUN=false

# Optional metadata/diagnostics
CANONICAL_JSON=
DOCUMENT_PUBLIC_ID=
DOCUMENT_TITLE=
ORIGINAL_FILENAME=
FILE_TYPE=
DOCUMENT_LANGUAGE=
PREVIEW_OUTPUT=
