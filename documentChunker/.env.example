# =========================================================
# Docker image / process
# =========================================================
DOCUMIND_INDEXER_IMAGE=documind-indexer-api:4.1.0
PYTHON_VERSION=3.12
TORCH_INDEX_URL=

# The API container runs with this UID/GID. The init container automatically
# prepares all writable volumes for these IDs on every `docker compose up`.
# Most Linux desktop users are 1000:1000. Change only when `id -u` / `id -g`
# return different values.
APP_UID=1000
APP_GID=1000

# =========================================================
# API
# =========================================================
API_PORT=8000
API_TITLE=DocuMind Indexer API
API_VERSION=4.1.0
API_LOG_LEVEL=info

# Optional. Leave empty to disable API-key authentication.
# When set, send: X-API-Key: <value>
API_KEY=

# Comma-separated origins, for example:
# http://localhost:3000,https://app.example.com
API_CORS_ORIGINS=

# One Uvicorn worker is intentional so the embedding model is reused in memory.
MAX_CONCURRENT_JOBS=1
JOB_HISTORY_LIMIT=1000
MODEL_PRELOAD=false
JOB_STATE_DIRECTORY=.jobs

# =========================================================
# Host directories
# =========================================================
# Existing PDF-package outputs. This root is mounted read-only.
DOCUMIND_INPUT_ROOT_HOST=/srv/DocuMind/pdf_example

# The init service creates/fixes this writable output root automatically.
DOCUMIND_OUTPUT_ROOT_HOST=/srv/DocuMind/pdf_example/indexer_output

# Docker-managed model cache. It survives `docker compose down` and avoids
# host-directory ownership problems. Do not use `docker compose down -v`
# unless you intentionally want to delete downloaded models.
HF_CACHE_VOLUME_NAME=documind-huggingface-cache

# These values are overridden to fixed container paths by docker-compose.yml.
INDEXER_INPUT_ROOT=/data/input
INDEXER_OUTPUT_ROOT=/data/output
EMBEDDING_CACHE_FOLDER=/models/huggingface

# =========================================================
# Canonical package / chunking
# =========================================================
CHUNKER_VERSION=hierarchical-assets-v3
CANONICAL_FILENAME=canonical_document.json
PREFER_SIDECAR_FILES=true
INFER_STANDARD_SIDECAR_PATHS=true

# Parent paragraph chunks
PARENT_ENABLED=true
PARENT_TARGET_TOKENS=900
PARENT_MAX_TOKENS=1100
PARENT_OVERLAP_TOKENS=0
PARENT_RETRIEVAL_ENABLED=false

# Child paragraph chunks
CHILD_ENABLED=true
CHILD_TARGET_TOKENS=300
CHILD_MAX_TOKENS=420
CHILD_OVERLAP_TOKENS=50
CHILD_RETRIEVAL_ENABLED=true

# Tables, figures, formulas: one standalone chunk each
SPECIAL_ELEMENTS_ENABLED=true
SPECIAL_ELEMENTS_MAX_TOKENS=1800
SPECIAL_ELEMENTS_OVERSIZE_POLICY=allow
SPECIAL_ELEMENTS_INCLUDE_CAPTION=true
SPECIAL_ELEMENTS_INCLUDE_DESCRIPTION_TEXT=true
SPECIAL_ELEMENTS_INCLUDE_SUMMARY=true
SPECIAL_ELEMENTS_INCLUDE_DESCRIPTION_DETAILS=true
SPECIAL_ELEMENTS_INCLUDE_TABLE_DATA=true
SPECIAL_ELEMENTS_INCLUDE_TABLE_LATEX=false
SPECIAL_ELEMENTS_INCLUDE_FORMULA_LATEX=true
SPECIAL_ELEMENTS_INCLUDE_FORMULA_TEXT=true
SPECIAL_ELEMENTS_RETRIEVAL_ENABLED=true

# References: separate records, not normal RAG chunks
REFERENCES_ENABLED=true
REFERENCES_EXCLUDE_SECTIONS_FROM_TEXT_CHUNKS=true
REFERENCES_SECTION_NAMES=reference,references,bibliography,works cited,literature cited,cited references
REFERENCES_RETRIEVAL_ENABLED=false
REFERENCES_GENERATE_RETRIEVAL_TEXT=false
REFERENCES_INCLUDE_RAW_TEXT=true
REFERENCES_INCLUDE_STRUCTURED_METADATA=true

# =========================================================
# Embeddings
# =========================================================
EMBEDDING_ENABLED=true
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_SELECTION=retrieval_enabled
EMBEDDING_BATCH_SIZE=8
EMBEDDING_DEVICE=auto
EMBEDDING_NORMALIZE=true
EMBEDDING_USE_DOCUMENT_ENCODER=true
EMBEDDING_USE_QUERY_ENCODER=true
EMBEDDING_SHOW_PROGRESS_BAR=false
EMBEDDING_REVISION=
EMBEDDING_TRUST_REMOTE_CODE=false
EMBEDDING_LOCAL_FILES_ONLY=false
EMBEDDING_EXPECTED_DIMENSIONS=1024
EMBEDDING_MAX_SEQUENCE_LENGTH=
EMBEDDING_MAX_INPUT_TOKENS=
EMBEDDING_OVERLONG_POLICY=error

# Only used when EMBEDDING_PROVIDER=development_hash for smoke tests.
EMBEDDING_DEVELOPMENT_HASH_DIMENSIONS=32
