# -----------------------------------------------------------------------------
# API service
# -----------------------------------------------------------------------------
INGESTOR_API_PORT=8080
# Optional. When set, clients must send this value in the X-API-Key header.
INGESTOR_API_KEY=sk_live_T0xqJiQotn-U7_rIpXMKIpEe48L6XVJz5Ovhw8-WZJfYrxgI

# Upload safety limits.
INGESTOR_MAX_UPLOAD_BYTES=536870912
INGESTOR_MAX_ARCHIVE_FILES=10000
INGESTOR_MAX_EXTRACTED_BYTES=2147483648

# -----------------------------------------------------------------------------
# OpenSearch connection
# -----------------------------------------------------------------------------
# Use the Docker service name when both containers share the documind network.
OPENSEARCH_URL=https://opensearch:9200
OPENSEARCH_INDEX=documind-chunks-v1

# Leave empty when OpenSearch security is disabled.
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=DOCUMIND_opensearch_password_2026
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_CA_CERTS=

OPENSEARCH_WAIT_TIMEOUT_SECONDS=120
OPENSEARCH_WAIT_INTERVAL_SECONDS=2
OPENSEARCH_REQUEST_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# Index template
# -----------------------------------------------------------------------------
OPENSEARCH_INSTALL_TEMPLATE=true
OPENSEARCH_TEMPLATE_NAME=documind-chunks-template
OPENSEARCH_TEMPLATE_FILE=/app/templates/index-template.json

# -----------------------------------------------------------------------------
# Default ingestion behaviour (may be overridden by request parameters)
# -----------------------------------------------------------------------------
OPENSEARCH_EMBEDDING_DIMENSIONS=1024
OPENSEARCH_BULK_BATCH_SIZE=250
INGESTOR_ALLOW_MISSING_EMBEDDINGS=false
INGESTOR_REPLACE_DOCUMENT=true
INGESTOR_REFRESH=true
