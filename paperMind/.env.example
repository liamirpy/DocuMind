# Project and ports
COMPOSE_PROJECT_NAME=pdf-analyser
APP_VERSION=0.3.0
TOOLS_BIND_HOST=127.0.0.1
TOOLS_PORT=5001
AGENT_BIND_HOST=127.0.0.1
AGENT_PORT=5000
GROBID_BIND_HOST=127.0.0.1
GROBID_PORT=5003
GROBID_ADMIN_PORT=5004

# Host output location. Relative paths are resolved from this project directory.
# Linux example: /srv/pdf-results
# macOS example: /Users/amir/pdf-results
# Windows Docker Desktop example: C:/Users/amir/pdf-results
OUTPUT_DIR=../pdf_example/pdf_analyser_output

# Optional second host output location. Requests select it with
# output_directory=/data/custom-output (the container path, not this host path).
CUSTOM_OUTPUT_DIR=../pdf_example/pdf_analyser_output_custom

# # # Path-based API access. HOST_ACCESS_ROOT is mounted once at /host.
# # # Use a narrow root such as /srv/DocuMind for normal operation.
# # # Set HOST_ACCESS_ROOT=/ only when this local API must reach the entire Linux host.
# # # Host /srv/DocuMind/pdf_example becomes /host/pdf_example in API requests.
# PATH_API_ENABLED=true
# HOST_ACCESS_ROOT=/srv/DocuMind/data
# ALLOWED_INPUT_DIRECTORIES=/host
# ALLOWED_OUTPUT_DIRECTORIES=/host

# Linux ownership for files written into OUTPUT_DIR.
# install.sh fills these automatically. Docker Desktop users can keep 1000/1000.
HOST_UID=1000
HOST_GID=1000

# Upload and worker limits
MAX_UPLOAD_SIZE_MB=100
MAX_CONCURRENCY=1
LOG_LEVEL=INFO

# Extraction
DOCLING_MAX_NUM_PAGES=300
DOCLING_MAX_CONCURRENCY=1
DOCLING_DOCUMENT_TIMEOUT_SECONDS=3600
TOOLS_TIMEOUT_SECONDS=3900
DOCLING_ACCELERATOR_NUM_THREADS=4
DOCLING_PRELOAD_ON_STARTUP=true
GROBID_TIMEOUT_SECONDS=1800
GROBID_MAX_RETRIES=2

# Canonical output
KEEP_RAW_EXTRACTOR_RESPONSE=false
OVERWRITE_EXISTING_PACKAGE=false
CREATE_ZIP_PACKAGE=true

# Ollama vision enrichment
LLM_ENABLED=true
LLM_DESCRIBE_ALL_ELEMENTS=true
LLM_MAX_ITEMS_PER_DOCUMENT=500
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_SERVER_KEEP_ALIVE=0
OLLAMA_REQUEST_KEEP_ALIVE=0
OLLAMA_TEMPERATURE=0.0

# Quality
QUALITY_GREEN_THRESHOLD=0.90
QUALITY_YELLOW_THRESHOLD=0.65





# # Path-based API access. HOST_ACCESS_ROOT is mounted once at /host.
# # Use a narrow root such as /srv/DocuMind for normal operation.
# # Set HOST_ACCESS_ROOT=/ only when this local API must reach the entire Linux host.
# # Host /srv/DocuMind/pdf_example becomes /host/pdf_example in API requests.
PATH_API_ENABLED=true
ALLOWED_INPUT_DIRECTORIES=/host
ALLOWED_OUTPUT_DIRECTORIES=/host
HOST_ACCESS_ROOT=/srv/DocuMind/data

# Backend-managed async job callbacks. Must match backend-api/.env.
BACKEND_CALLBACK_BASE_URL=http://api:3000/internal/papermind/jobs
PAPERMIND_CALLBACK_TOKEN=replace-with-a-long-random-secret
BACKEND_CALLBACK_TIMEOUT_SECONDS=10
BACKEND_CALLBACK_MAX_RETRIES=5
